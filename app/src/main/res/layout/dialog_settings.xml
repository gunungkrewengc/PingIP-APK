<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode Eksekusi Mode Pesawat"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbShizuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Shizuku" />

            <RadioButton
                android:id="@+id/rbRoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Root (su)" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Metode Cek Ping"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbHttps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="HTTPS HEAD" />

            <RadioButton
                android:id="@+id/rbTcp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TCP 443 (Ringan)" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbPauseWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-Jeda saat terhubung ke Wi-Fi" />

        <CheckBox
            android:id="@+id/cbCompactLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Mode Log Ringkas (hanya catat RTO/Jeda/Toggle)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jeda ON-OFF Mode Pesawat (detik)" />
        <EditText
            android:id="@+id/etAirplaneDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooldown Normal setelah Mode Pesawat (detik)" />
        <EditText
            android:id="@+id/etCooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Interval Cek Ping (detik)" />
        <EditText
            android:id="@+id/etInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Timeout Maksimal Ping (detik)" />
        <EditText
            android:id="@+id/etTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batas Gagal RTO (kali)" />
        <EditText
            android:id="@+id/etMaxFail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Anti-Loop: Batas Toggle Beruntun Tanpa OK (0 = nonaktif)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etAntiLoopLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anti-Loop: Cooldown Saat Melambat (detik)" />
        <EditText
            android:id="@+id/etAntiLoopCooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Kecepatan Watcher Native (detik, min 0.2)" />
        <EditText
            android:id="@+id/etWatcherInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coba Ulang Shizuku di Awal (detik, min 0.5)" />
        <EditText
            android:id="@+id/etShizukuRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batas Baris Log Layar" />
        <EditText
            android:id="@+id/etMaxLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target Ping Utama (contoh: dns.google atau 1.1.1.1)" />
        <EditText
            android:id="@+id/etTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target Ping Cadangan (opsional, kosong = nonaktif)" />
        <EditText
            android:id="@+id/etFallbackTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="contoh: 1.1.1.1"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filter Paket VPN (kosongkan = semua VPN)" />
        <EditText
            android:id="@+id/etVpnPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="xyz.easypro.httpcustom"
            android:inputType="text" />
    </LinearLayout>
</ScrollView>
